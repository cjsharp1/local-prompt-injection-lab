{
  "name": "local-prompt-injection-lab",
  "version": "0.1.0",
  "description": "A local teaching lab for prompt injection: a small support assistant running on your machine through Ollama, a static library of attacks, six switchable defences, and code-scored results that pair attack success with the cost in blocked legitimate work. No API key, no hosted model.",
  "main": "server/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.client.json && tsx watch server/index.ts",
    "build": "tsc && tsc -p tsconfig.client.json && tsx scripts/copy-data.ts",
    "build:client": "tsc -p tsconfig.client.json",
    "watch:client": "tsc -p tsconfig.client.json --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "audit-comments": "tsx scripts/audit-comments.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check-env": "tsx scripts/check-env.ts",
    "seed": "tsx scripts/seed.ts",
    "tool-server:http": "tsx tool-server/http.ts",
    "try-model": "tsx scripts/try-model.ts",
    "try-tools": "tsx scripts/try-tools.ts",
    "attack": "tsx scripts/attack.ts",
    "arena": "tsx scripts/arena.ts",
    "model-eval": "tsx scripts/model-eval.ts"
  },
  "keywords": [
    "prompt-injection",
    "llm-security",
    "ollama",
    "local-llm",
    "mcp",
    "model-context-protocol",
    "guardrails",
    "learning"
  ],
  "author": "Chris Sharp",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
