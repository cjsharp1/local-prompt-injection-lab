# ---------------------------------------------------------------------------
# Template for the environment file.
#
# This file IS committed and holds no secrets. Copy it to .env if you want
# one — .env is git-ignored, so anything you put there stays on your machine.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# You do NOT need this file to run the lab. Every setting below has a working
# default; a .env only matters if you want to change one.
#
# ---------------------------------------------------------------------------
# Why there is no API key here
# ---------------------------------------------------------------------------
#
# Most AI app templates start with an API key. This one does not, and that
# absence is the point: THIS LAB NEVER CALLS A HOSTED MODEL.
#
# The models run on your machine through Ollama. The shop, its customers and
# its tickets sit in a SQLite file next to this one. Every attack in the
# library is aimed at that invented shop, and nothing — not a prompt, not a
# canary secret, not a "sent" email — leaves the machine.
# ---------------------------------------------------------------------------

# Port the lab's UI (workspace, attack studio, log, pipeline view) listens on.
PORT=3300

# Port the tool MCP server listens on when run over HTTP with
# `npm run tool-server:http` — for MCP Inspector or another MCP client.
# The app itself does not use this: it talks to the tool server over stdio.
TOOL_SERVER_PORT=3301

# Where Ollama is listening. This is Ollama's own default.
#
# Keep it on localhost. Pointing it at another machine sends every ticket,
# every attack payload and every planted secret across the network — the
# thing this project exists to avoid.
OLLAMA_URL=http://127.0.0.1:11434

# The model to use when the UI or a script has not picked one.
#
# PROVISIONAL. The model eval (`npm run model-eval`, build step 13) measures
# both installed models on the benign suite, and this default is set from
# that table — with the reason written here — not from reputation.
#
# Every role in a run (the main assistant, the input classifier, the
# quarantined reader) uses this one model. On a 4 GB GPU only one of the two
# models stays loaded, and switching costs a 5–8 second reload (measured; see
# docs/verified-facts.md).
#
# Must be a LOCAL model. Names ending in ":cloud" run on ollama.com, and the
# lab refuses them.
MODEL=qwen3.5:4b

# Context window, in tokens, sent as options.num_ctx on every request.
#
# Set explicitly because Ollama's default is small (4096 on most laptops),
# and when a conversation outgrows it Ollama SILENTLY DROPS whole older
# messages — keeping the system prompt and the newest message, reporting no
# error. A dropped message can be a tool result, or the attack itself. The
# lab flags it when it happens. 8192 fits the ticket, an attachment, six tool
# definitions and a few tool results; a larger value costs memory and, on a
# 4 GB GPU, speed.
NUM_CTX=8192
